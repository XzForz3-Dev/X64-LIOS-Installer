/* General App Background */
QWidget {
    background-color: #0b0b0d;
    color: #e0e0e0;
    font-family: "Noto Sans", sans-serif;
}

#mainApp, #sidebarApp {
    background-color: #0b0b0d;
}

/* Sidebar List */
QListView#stepList {
    background-color: transparent;
    color: #888888;
    border: none;
    padding: 10px;
    outline: none;
}
QListView#stepList::item {
    padding: 8px 12px;
    border-radius: 4px;
    margin-bottom: 4px;
}
QListView#stepList::item:hover {
    background-color: #1a1a1d;
    color: #cccccc;
}
QListView#stepList::item:selected {
    background-color: #b31b1b;
    color: #ffffff;
    font-weight: bold;
}

/* Buttons */
QPushButton {
    qproperty-icon: url();
    qproperty-iconSize: 0px 0px;
    background-color: #1f1f22;
    color: #ffffff;
    border: 1px solid #333336;
    border-radius: 6px;
    padding: 8px 20px;
    font-weight: 500;
    outline: none;
}
QPushButton:hover {
    background-color: #2a2a2d;
    border-color: #555558;
}
QPushButton:focus {
    border: 1px solid #b31b1b;
}
QPushButton:default {
    border: 1px solid #b31b1b;
}
QPushButton:pressed {
    background-color: #b31b1b;
    border-color: #ff2a2a;
}
QPushButton:disabled {
    background-color: #151518;
    color: #555555;
    border-color: #222225;
}

/* Inputs / ComboBoxes */
QLineEdit, QComboBox, QSpinBox, QListView, QTableView {
    background-color: #151518;
    color: #e0e0e0;
    border: 1px solid #333336;
    border-radius: 4px;
    padding: 4px 8px;
    selection-background-color: #b31b1b;
    selection-color: #ffffff;
    outline: none;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border-color: #b31b1b;
}
QComboBox:hover {
    border-color: #b31b1b;
}

/* TreeView and HeaderView (Netinstall Package Tree) */
QHeaderView {
    background-color: #151518;
    border: none;
}
QHeaderView::section {
    background-color: #18181c;
    color: #ffffff;
    padding: 6px 10px;
    border: none;
    border-right: 1px solid #28282c;
    border-bottom: 1px solid #333336;
    font-weight: bold;
}
QTreeView {
    background-color: #121215;
    color: #e0e0e0;
    border: 1px solid #28282c;
    border-radius: 4px;
    padding: 4px;
    outline: none;
    selection-background-color: #b31b1b;
    selection-color: #ffffff;
}
QTreeView::item {
    padding: 3px 6px;
    border-radius: 3px;
}
QTreeView::item:hover {
    background-color: #1e1e24;
}
QTreeView::item:selected {
    background-color: #b31b1b;
    color: #ffffff;
}

/* Progress Bar */
QProgressBar {
    background-color: #151518;
    border: 1px solid #333336;
    border-radius: 4px;
    text-align: center;
    color: white;
}
QProgressBar::chunk {
    background-color: #b31b1b;
    border-radius: 3px;
}

/* Labels and Text */
QLabel {
    color: #e0e0e0;
    background: transparent;
}
QCheckBox, QRadioButton {
    color: #e0e0e0;
    spacing: 8px;
}

/* QQuickWidget Slideshow Container */
QQuickWidget, QQuickView, #executionViewStep, #viewManager, QStackedWidget {
    background-color: #0b0b0d;
    border: none;
}

