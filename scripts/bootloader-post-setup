#!/usr/bin/env bash

# 1. Permanently neutralize CachyOS branding hooks and enforce X64 LIOS OS identity
mkdir -p /etc/pacman.d/hooks
ln -sf /dev/null /etc/pacman.d/hooks/cachyos-branding.hook
ln -sf /dev/null /etc/pacman.d/hooks/os-release.hook
ln -sf /dev/null /etc/pacman.d/hooks/lsb-release.hook

cat << 'EOF' > /usr/lib/os-release
NAME="X64 LIOS Linux"
PRETTY_NAME="X64 LIOS Linux"
ID=x64lios
ID_LIKE=arch
BUILD_ID=rolling
ANSI_COLOR="1;31"
HOME_URL="https://x64studios.com/"
DOCUMENTATION_URL="https://x64studios.com/docs"
SUPPORT_URL="https://x64studios.com/support"
BUG_REPORT_URL="https://github.com/XzForz3-Dev"
PRIVACY_POLICY_URL="https://x64studios.com/privacy"
LOGO=x64lios
EOF
ln -sf ../usr/lib/os-release /etc/os-release

cat << 'EOF' > /etc/lsb-release
DISTRIB_ID=x64lios
DISTRIB_RELEASE="rolling"
DISTRIB_DESCRIPTION="X64 LIOS Linux"
EOF

# 2. Configure Plymouth Boot Splash safely BEFORE bootloader initramfs generation
if pacman -Qq plymouth 2>/dev/null; then
    echo "Configuring X64 LIOS Plymouth Boot Splash..."
    mkdir -p /etc/plymouth
    cat << 'EOF' > /etc/plymouth/plymouthd.conf
[Daemon]
Theme=x64-lios
ShowDelay=0
DeviceTimeout=8
EOF

    # Ensure clean Plymouth termination without locking DRM framebuffer
    rm -rf /etc/systemd/system/plymouth-quit.service.d

    if [ -f /etc/mkinitcpio.conf ]; then
        if grep -q "plymouth" /etc/mkinitcpio.conf; then
            sed -i -E 's/plymouth //g; s/ plymouth//g' /etc/mkinitcpio.conf
            sed -i -E 's/filesystems/plymouth filesystems/' /etc/mkinitcpio.conf
        fi
    fi
fi

# 3. Bootloader-specific post-setup and initramfs synchronization
if pacman -Qq limine 2>/dev/null; then
    # Ensure chroot DNS is active if /etc/resolv.conf points to an inactive systemd-resolved stub
    if [ -L /etc/resolv.conf ] && grep -q "127.0.0.53" /etc/resolv.conf 2>/dev/null; then
        rm -f /etc/resolv.conf
        printf "nameserver 1.1.1.1\nnameserver 8.8.8.8\n" > /etc/resolv.conf
    fi

    limine_snapper_config="/etc/limine-snapper-sync.conf"

    if [ -e "$limine_snapper_config" ]; then
        sed -i 's/^#*TARGET_OS_NAME=.*/TARGET_OS_NAME="X64 LIOS Linux"/' "$limine_snapper_config"
        sed -i 's|^#*ESP_PATH=.*|ESP_PATH="/boot/efi"|' "$limine_snapper_config"

        pacman -S --noconfirm --needed cachyos-snapper-support
        systemctl enable limine-snapper-sync.service &>/dev/null
    fi

    # Remove temporary mkinitcpio hook if still present, then replace limine-entry-tool with limine-mkinitcpio-hook
    rm -f /etc/pacman.d/hooks/90-mkinitcpio-install.hook /usr/share/libalpm/scripts/mkinitcpio-install-calamares
    pacman -R --noconfirm limine-entry-tool 2>/dev/null || true
    pacman -S --noconfirm --needed --overwrite '*' limine-mkinitcpio-hook

    if [ -e "$limine_snapper_config" ]; then
        mkdir -p /etc/mkinitcpio.conf.d
        if grep -q "^HOOKS=.*systemd" /etc/mkinitcpio.conf 2>/dev/null; then
            cat << 'EOF' > /etc/mkinitcpio.conf.d/10-limine-snapper-sync.conf
# This hook is necessary for the proper loading of Limine snapshots.
HOOKS+=(sd-btrfs-overlayfs)
EOF
        else
            cat << 'EOF' > /etc/mkinitcpio.conf.d/10-limine-snapper-sync.conf
# This hook is necessary for the proper loading of Limine snapshots.
HOOKS+=(btrfs-overlayfs)
EOF
        fi
    fi

    if [ -f /usr/share/limine/x64-limine-splash.png ] && [ -d /boot/efi ]; then
        cp -f /usr/share/limine/x64-limine-splash.png /boot/efi/x64-limine-splash.png
    fi

    # Ensure /boot/efi/limine.conf has official X64 LIOS theme and header with machine-id underneath
    if [ -d /boot/efi ] && [ -f /etc/machine-id ]; then
        MID=$(tr -d '\n' < /etc/machine-id)
        cat << EOF > /boot/efi/limine.conf
timeout: 5
default_entry: 2
remember_last_entry: yes

# X64 LIOS Limine Theme
interface_branding: X64 LIOS  •  GAMING EDITION
interface_branding_colour: ff3b3b
interface_help_colour: ff3b3b
interface_help_colour_bright: ff6b6b
term_palette: 0d0d11;ff3b3b;4ade80;fbbf24;38bdf8;e879f9;a1a1aa;d4d4d8
term_palette_bright: 27272a;ff5555;4ade80;fbbf24;38bdf8;e879f9;f4f4f6;ffffff
term_background: 900a0a0e
term_foreground: f4f4f6
term_background_bright: ff3b3b
term_foreground_bright: ffffff
term_margin: 80
term_margin_gradient: 4
wallpaper: boot():/x64-limine-splash.png
wallpaper_style: stretched

/+X64 LIOS Linux
comment: machine-id=${MID}
EOF
    fi

    limine-update
elif pacman -Qq systemd-boot-manager 2>/dev/null && bootctl --esp-path=/boot/efi is-installed 2>/dev/null; then
    echo "Finalizing X64 LIOS systemd-boot configuration..."
    # Neutralize sdboot-manage hooks that assume ESP=/boot, and use systemd's native kernel-install for /boot/efi
    ln -sf /dev/null /etc/pacman.d/hooks/sdboot-kernel-update.hook
    ln -sf /dev/null /etc/pacman.d/hooks/sdboot-kernel-remove.hook

    for kmod in /usr/lib/modules/*/vmlinuz; do
        if [ -f "$kmod" ]; then
            kver=$(basename "$(dirname "$kmod")")
            kernel-install add "$kver" "$kmod" || true
        fi
    done

    if compgen -G "/boot/efi/loader/entries/*.conf" > /dev/null; then
        sed -i 's/^title\s\+.*/title      X64 LIOS Linux/' /boot/efi/loader/entries/*.conf
        sed -i 's/^sort-key\s\+.*/sort-key   x64lios/' /boot/efi/loader/entries/*.conf
    fi
elif pacman -Qq grub 2>/dev/null; then
    echo "Finalizing X64 LIOS GRUB configuration..."
    mkinitcpio -P || true

    if [ -f /boot/vmlinuz-linux-cachyos-deckify ]; then
        target_kernel="/boot/vmlinuz-linux-cachyos-deckify"
    else
        target_kernel="/boot/vmlinuz-linux-cachyos"
    fi

    if [ -f /etc/default/grub ]; then
        if grep -q "^GRUB_TOP_LEVEL=" /etc/default/grub; then
            sed -i "s|^GRUB_TOP_LEVEL=.*|GRUB_TOP_LEVEL=\"${target_kernel}\"|" /etc/default/grub
        else
            echo "GRUB_TOP_LEVEL=\"${target_kernel}\"" >> /etc/default/grub
        fi
    fi

    if [ -d /usr/share/grub/themes/x64 ] && [ ! -d /boot/grub/themes/x64 ]; then
        mkdir -p /boot/grub/themes
        cp -rn /usr/share/grub/themes/x64 /boot/grub/themes/
    fi

    # Ensure Btrfs snapshots in GRUB title strictly "X64 LIOS Linux snapshots"
    if [ -f /etc/default/grub-btrfs/config ]; then
        sed -i 's/^#*GRUB_BTRFS_SUBMENUNAME=.*/GRUB_BTRFS_SUBMENUNAME="X64 LIOS Linux snapshots"/' /etc/default/grub-btrfs/config
    fi

    if [ -f /boot/grub/grub.cfg ]; then
        grub-mkconfig -o /boot/grub/grub.cfg || true
    fi
elif pacman -Qq refind 2>/dev/null && [ -d /boot/efi/EFI/refind ]; then
    echo "Finalizing X64 LIOS rEFInd configuration..."
    mkinitcpio -P || true

    if [ -d /usr/share/refind/themes/x64-lios ]; then
        mkdir -p /boot/efi/EFI/refind/themes
        cp -rf /usr/share/refind/themes/x64-lios /boot/efi/EFI/refind/themes/
        if [ -f /usr/share/refind/themes/x64-lios/icons/os_linux.png ]; then
            rm -f /boot/.VolumeIcon.png /.VolumeIcon.png /boot/efi/.VolumeIcon.png 2>/dev/null || true
            for k in /boot/vmlinuz-*; do
                [ -f "$k" ] && cp -f /usr/share/refind/themes/x64-lios/icons/os_linux.png "${k}.png" || true
            done
        fi
    fi

    # Sync UEFI Fallback directory (/boot/efi/EFI/BOOT/BOOTX64.EFI) and remove stale OVMF NvVars
    mkdir -p /boot/efi/EFI/BOOT
    cp -rf /boot/efi/EFI/refind/* /boot/efi/EFI/BOOT/
    [ -f /boot/efi/EFI/BOOT/refind_x64.efi ] && mv -f /boot/efi/EFI/BOOT/refind_x64.efi /boot/efi/EFI/BOOT/BOOTX64.EFI
    rm -f /boot/efi/NvVars 2>/dev/null || true
else
    mkinitcpio -P || true
fi

# 4. Ensure systemd-oomd is completely eradicated from startup and slice auto-activation is neutralized
mkdir -p /etc/systemd/system/system.slice.d /etc/systemd/system/user-.slice.d
ln -sf /dev/null /etc/systemd/system/system.slice.d/10-oomd-per-slice-defaults.conf
ln -sf /dev/null /etc/systemd/system/user-.slice.d/10-oomd-per-slice-defaults.conf
rm -f /etc/systemd/system/multi-user.target.wants/systemd-oomd.service 2>/dev/null || true
rm -f /etc/systemd/system/sockets.target.wants/systemd-oomd.socket 2>/dev/null || true
rm -f /etc/systemd/system/dbus-org.freedesktop.oom1.service 2>/dev/null || true
rm -f /etc/systemd/system/timers.target.wants/fwupd-refresh.timer 2>/dev/null || true
SYSTEMD_OFFLINE=1 systemctl --root=/ disable systemd-oomd.service systemd-oomd.socket 2>/dev/null || true
